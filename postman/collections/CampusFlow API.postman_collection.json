        {
          "name": "Get Ticket Categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "const categories =",
                  "    response.data?.categories ||",
                  "    response.data?.ticketCategories ||",
                  "    response.categories ||",
                  "    response.ticketCategories ||",
                  "    response.data ||",
                  "    response;",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains success true\", function () {",
                  "    pm.expect(response.success).to.eql(true);",
                  "});",
                  "",
                  "pm.test(\"Response contains category list\", function () {",
                  "    pm.expect(categories).to.be.an(\"array\");",
                  "    pm.expect(categories.length).to.be.greaterThan(0);",
                  "});",
                  "",
                  "if (Array.isArray(categories) && categories.length > 0) {",
                  "    const firstCategory = categories[0];",
                  "",
                  "    if (firstCategory.id) {",
                  "        pm.environment.set(\"categoryId\", firstCategory.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
