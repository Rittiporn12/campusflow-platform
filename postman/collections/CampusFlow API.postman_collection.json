      "name": "Auth API",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 201\", function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test(\"Response contains success true\", function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.eql(true);",
                  "});",
                  "",
                  "pm.test(\"Response contains registered user data\", function () {",
                  "    const response = pm.response.json();",
                  "",
                  "    pm.expect(response.data).to.have.property(\"user\");",
                  "    pm.expect(response.data.user).to.have.property(\"id\");",
                  "    pm.expect(response.data.user).to.have.property(\"email\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Postman Test User\",\n    \"email\": \"postman.user{{$timestamp}}@campusflow.dev\",\n    \"password\": \"{{defaultPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
